{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyDearDarlingEc2RoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::539746929196:role/deardarling-dev-ec2-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
      }
    }
  ]
}
