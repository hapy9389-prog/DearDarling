{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupUpload",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::deardarling-dev-backups-539746929196-ap-northeast-2/postgres/dev/*"
    },
    {
      "Sid": "BackupUploadVerify",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::deardarling-dev-backups-539746929196-ap-northeast-2",
      "Condition": {
        "StringLike": { "s3:prefix": "postgres/dev/*" }
      }
    }
  ]
}
