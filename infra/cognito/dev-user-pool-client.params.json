{
  "GenerateSecret": true,
  "ExplicitAuthFlows": ["ALLOW_USER_PASSWORD_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"],
  "PreventUserExistenceErrors": "ENABLED",
  "EnableTokenRevocation": true,
  "AccessTokenValidity": 1,
  "IdTokenValidity": 1,
  "RefreshTokenValidity": 30,
  "TokenValidityUnits": {
    "AccessToken": "hours",
    "IdToken": "hours",
    "RefreshToken": "days"
  }
}
