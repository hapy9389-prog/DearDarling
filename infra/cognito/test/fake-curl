#!/bin/bash
# verify-auth-flow.sh를 실제 서버 없이 검증하기 위한 가짜 curl. 실제 네트워크 호출을 절대
# 하지 않는다. FAKE_HTTP_MODE로 오류 시나리오를 고르고, FAKE_HTTP_STATE_DIR에 "세션 토큰 →
# active/revoked" 상태를 기록해 login/me/logout/logout-all 사이의 인과관계를 재현한다.
set -euo pipefail
MODE="${FAKE_HTTP_MODE:-happy}"
STATE_DIR="${FAKE_HTTP_STATE_DIR:?FAKE_HTTP_STATE_DIR 필요}"
mkdir -p "$STATE_DIR/tokens"

OUT_FILE="/dev/null"; JAR_WRITE=""; JAR_READ=""; DATA_FILE=""
args=("$@")
n=${#args[@]}
i=0
while [ $i -lt $n ]; do
  a="${args[$i]}"
  case "$a" in
    -o) i=$((i + 1)); OUT_FILE="${args[$i]}" ;;
    -c) i=$((i + 1)); JAR_WRITE="${args[$i]}" ;;
    -b) i=$((i + 1)); JAR_READ="${args[$i]}" ;;
    --data) i=$((i + 1)); DATA_FILE="${args[$i]#@}" ;;
  esac
  i=$((i + 1))
done
URL="${args[$((n - 1))]}"
PATH_ONLY="$(printf '%s' "$URL" | sed -E 's#^https?://[^/]+##')"

# 요청 본문(JSON, verify-auth-flow.sh의 payload_file이 만든 것)에서 한 필드만 뽑는다.
body_field() {  # $1=필드명
  [ -n "$DATA_FILE" ] && [ -f "$DATA_FILE" ] || { printf ''; return 0; }
  node -e '
    const fs = require("fs");
    try {
      const body = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(body[process.argv[2]] ?? ""));
    } catch { /* 무시 */ }
  ' "$DATA_FILE" "$1"
}

read_cookie_token() {  # $1=jar파일 -> dd_session 값(없으면 빈 문자열)
  [ -f "$1" ] || { printf ''; return 0; }
  awk -F'\t' '$6=="dd_session"{print $7}' "$1" | tail -1
}
write_cookie_token() {  # $1=jar파일 $2=token
  { echo '# Netscape HTTP Cookie File'; printf '127.0.0.1\tFALSE\t/\tFALSE\t0\tdd_session\t%s\n' "$2"; } > "$1"
}
clear_cookie() {  # $1=jar파일 -> dd_session 줄 제거(서버의 만료 지시를 흉내)
  [ -f "$1" ] || return 0
  awk -F'\t' '$6 != "dd_session"' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}
mark_token() { printf '%s' "$2" > "$STATE_DIR/tokens/$1.status"; }  # $1=token $2=active|revoked
token_status() { [ -f "$STATE_DIR/tokens/$1.status" ] && cat "$STATE_DIR/tokens/$1.status" || echo "revoked"; }
new_token() {
  local c
  c="$(cat "$STATE_DIR/counter" 2>/dev/null || echo 0)"
  c=$((c + 1))
  echo "$c" > "$STATE_DIR/counter"
  printf 'tok%03d' "$c"
}
emit() { printf '%s' "${2:-}" > "$OUT_FILE"; printf '%s' "$1"; }  # $1=http_code $2=body

case "$PATH_ONLY" in
  /api/auth/signup | /api/auth/confirm-signup | /api/auth/forgot-password)
    emit 200 '{}'
    ;;
  /api/auth/confirm-forgot-password)
    # 실제 서버(authService.confirmForgotPassword)는 성공 시 auth_version을 올려 그 사용자의
    # 기존 세션을 전부 차단한다 — 가짜 curl도 같은 인과관계를 흉내내려고 모든 토큰을 revoked로
    # 바꾸고, 이후 로그인은 이 새 비밀번호로만 성공하도록 "현재 비밀번호"를 갱신해 둔다.
    NEWPW="$(body_field newPassword)"
    if [ -n "$NEWPW" ]; then printf '%s' "$NEWPW" > "$STATE_DIR/current_password"; fi
    for f in "$STATE_DIR"/tokens/*.status; do [ -f "$f" ] && printf 'revoked' > "$f"; done
    emit 200 '{}'
    ;;
  /api/auth/login)
    # 비밀번호 재설정이 한 번이라도 일어났으면(current_password 파일 존재) 그 값과 일치할 때만
    # 로그인을 허용한다 — "예전 비밀번호 로그인 거부"를 오프라인으로 검증하기 위해서다. 재설정
    # 전에는(파일이 없으면) 어떤 비밀번호든 통과시킨다(가입 시점 검증은 이 가짜의 범위 밖).
    if [ -f "$STATE_DIR/current_password" ]; then
      GIVEN_PW="$(body_field password)"
      CURRENT_PW="$(cat "$STATE_DIR/current_password")"
      if [ "$GIVEN_PW" != "$CURRENT_PW" ]; then
        emit 401 '{"error":"invalid-credentials"}'
        exit 0
      fi
    fi
    TOKEN="$(new_token)"
    mark_token "$TOKEN" active
    [ -n "$JAR_WRITE" ] && write_cookie_token "$JAR_WRITE" "$TOKEN"
    emit 200 '{}'
    ;;
  /api/auth/me)
    T="$(read_cookie_token "${JAR_READ:-/nonexistent}")"
    if [ -n "$T" ] && [ "$(token_status "$T")" = "active" ]; then
      emit 200 '{"authenticated":true,"userId":"u1"}'
    else
      emit 200 '{"authenticated":false}'
    fi
    ;;
  /api/auth/logout)
    if [ "$MODE" = "logout_error" ]; then
      emit 500 '{"error":"fake"}'
    else
      T="$(read_cookie_token "${JAR_READ:-/nonexistent}")"
      [ -n "$T" ] && mark_token "$T" revoked
      [ -n "$JAR_WRITE" ] && clear_cookie "$JAR_WRITE"
      emit 204 ''
    fi
    ;;
  /api/auth/logout-all)
    if [ "$MODE" = "logout_all_error" ]; then
      emit 500 '{"error":"fake"}'
    else
      for f in "$STATE_DIR"/tokens/*.status; do [ -f "$f" ] && printf 'revoked' > "$f"; done
      emit 204 ''
    fi
    ;;
  *)
    emit 404 '{"error":"fake-not-found"}'
    ;;
esac
