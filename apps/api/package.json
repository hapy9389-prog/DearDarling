{
  "name": "@deardarling/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -b --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "tsx scripts/migrate.ts",
    "pretest": "tsx scripts/ensure-test-db.ts && tsx scripts/migrate.ts --test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1120.0",
    "aws-jwt-verify": "5.2.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
