# 실제 값은 .env(gitignore 처리됨)에만 넣는다 — 이 파일에는 키 이름만 남긴다.

NODE_ENV=development
PORT=3000

# docker-compose.yml의 기본 계정과 맞춘 로컬 개발 DB.
DATABASE_URL=postgres://deardarling:deardarling_local_dev@127.0.0.1:5432/deardarling_dev

# 테스트는 반드시 "_test"로 끝나는 별도 DB에서만 실행된다(test/setup.ts가 강제 확인).
TEST_DATABASE_URL=postgres://deardarling:deardarling_local_dev@127.0.0.1:5432/deardarling_test

# 명시적 로컬 테스트 모드에서만 "true"로 설정 — X-Test-User-Id 헤더로 인증을 대체한다.
# NODE_ENV=production이면 true여도 서버가 기동을 거부한다(src/config/env.ts).
LOCAL_TEST_AUTH=false
