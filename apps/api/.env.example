# 실제 값은 .env(gitignore 처리됨)에만 넣는다 — 이 파일에는 키 이름만 남긴다.

NODE_ENV=development
PORT=3000

# 상태를 바꾸는 요청(Origin 검사)에서 허용할 출처 — 필수값이다(src/config/env.ts가 누락 시
# 기동을 거부한다). 기본값으로 추측하지 않는다.
ALLOWED_ORIGIN=http://127.0.0.1:3000

# docker-compose.yml의 기본 계정과 맞춘 로컬 개발 DB.
DATABASE_URL=postgres://deardarling:deardarling_local_dev@127.0.0.1:5432/deardarling_dev

# 테스트는 반드시 "_test"로 끝나는 별도 DB에서만 실행된다(test/setup.ts가 강제 확인).
TEST_DATABASE_URL=postgres://deardarling:deardarling_local_dev@127.0.0.1:5432/deardarling_test

# 명시적 로컬 테스트 모드에서만 "true"로 설정 — X-Test-User-Id 헤더로 인증을 대체한다.
# NODE_ENV=production이면 true여도 서버가 기동을 거부한다(src/config/env.ts).
LOCAL_TEST_AUTH=false

# Cognito User Pool·App Client 설정 — 넷 다 채워지기 전까지는 서버가 실제 Cognito 대신
# 개발용 스텁으로 기동한다(src/server.ts). NODE_ENV=production에서는 넷 다 없으면 기동을 거부한다.
# 아직 실제 User Pool을 만들지 않았다 — 값은 승인 후 채운다.
# COGNITO_REGION=ap-northeast-2
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=

# sessions.cognito_refresh_token_encrypted를 암호화(AES-256-GCM)할 32바이트 키를 base64로.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 없으면 refresh token을 저장하지 않는다(로그인은 그대로 동작하지만, 정리 루틴의 Cognito 쪽
# RevokeToken 위생 관리는 동작하지 않는다). NODE_ENV=production에서는 없으면 기동을 거부한다.
# SESSION_TOKEN_ENCRYPTION_KEY=
